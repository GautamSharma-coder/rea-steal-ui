{
  "name": "rea-steal-ui",
  "version": "1.0.0-beta.1",
  "description": "Extract complete design systems, color tokens, icons, and clean React + Tailwind components from any packaged desktop app or web bundle in 60 seconds.",
  "type": "module",
  "bin": {
    "rea-steal-ui": "./dist/bin/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/bin/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.ts\" \"test/**/*.ts\"",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@clack/prompts": "^0.9.0",
    "@electron/asar": "^4.3.1",
    "cheerio": "^1.0.0",
    "colord": "^2.9.3",
    "commander": "^13.0.0",
    "culori": "^4.0.0",
    "picocolors": "^1.1.0",
    "postcss": "^8.5.0",
    "postcss-value-parser": "^4.2.0",
    "svgo": "^3.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "design-system",
    "react",
    "tailwind",
    "reverse-engineer",
    "ui-kit",
    "component-library",
    "storybook",
    "cli",
    "electron",
    "asar",
    "ast",
    "babel",
    "svg",
    "icons",
    "color-tokens"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rea-steal-ui/rea-steal-ui.git"
  },
  "bugs": {
    "url": "https://github.com/rea-steal-ui/rea-steal-ui/issues"
  },
  "homepage": "https://github.com/rea-steal-ui/rea-steal-ui#readme",
  "license": "MIT",
  "author": "rea-steal-ui contributors"
}
